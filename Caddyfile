# Host-level Caddy for the ClipZard production deployment.
#
# The docker-compose stack publishes loopback-only ports:
#   backend -> 127.0.0.1:8000   web -> 127.0.0.1:3005
#
# Site: https://clipzard.web.id (DNS A record -> this VM)
# API surface (same-origin from the browser): https://clipzard.web.id/api/v1/*
# The email below gets Let's Encrypt expiry notices.
{
	# Don't ship Caddy's version banner anywhere.
	servers {
		protocols h1 h2 h3
	}
}

clipzard.web.id {
	# Modern TLS only. Caddy handles ACME issuance/renewal automatically;
	# http:// requests are redirected to https:// by Caddy itself.
	tls {
		protocols tls1.2 tls1.3
	}

	# ─────────────────────────── response headers ───────────────────────────
	header {
		# Fingerprinting / framework banners.
		-Server
		-X-Powered-By
		-X-AspNet-Version

		# Browser-enforced protections.
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"

		# CSP tuned for Next.js + third-party integrations:
		# - Next.js needs 'unsafe-inline' styles/scripts for its hydration
		#   bootstrap.
		# - media/img/connect allow https so presigned S3/R2 video URLs and
		#   browser PUT-uploads keep working.
		# - Cloudflare Turnstile: widget script + its verification iframe
		#   (challenges.cloudflare.com).
		# - Google Analytics: gtag loader (googletagmanager) + beacon
		#   endpoints (covered by connect-src https: / img-src https:).
		# - Google OAuth: Identity Services scripts + the sign-in popup/
		#   One-Tap iframes (accounts.google.com, apis.google.com).
		# High-value directives unchanged: frame-ancestors 'none' (click-
		# jacking), object-src 'none', base-uri 'self'.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com https://www.googletagmanager.com https://*.google-analytics.com https://accounts.google.com https://apis.google.com https://www.youtube.com https://s.youtube.com https://*.youtube.com https://*.ytimg.com https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: blob:; font-src 'self' data:; frame-src https://challenges.cloudflare.com https://accounts.google.com https://www.youtube.com https://www.youtube-nocookie.com https://*.youtube.com https://*.youtube-nocookie.com https://*.ytimg.com; worker-src 'self' blob:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
	}

	# ────────────────────── probe / scanner path blocking ───────────────────
	# Return 404 fast for the endless automated scans; never let these reach
	# the apps or hit the disk.
	@probes path \
	 /.git* /.env* /.aws* /.ssh* /*.sql /*.bak /*.old /*.swp \
	 /wp-admin* /wp-login.php /xmlrpc.php /phpmyadmin* /pma* \
	 /adminer* /*.php /actuator* /metrics /debug/* \
	 /Dockerfile /docker-compose*.yml /package.json /composer.json
	respond @probes 404

	# Only the documented HTTP methods are meaningful for this app.
	@badmethods method TRACE TRACK CONNECT
	respond @badmethods 405

	# ───────────────────────────── body limits ──────────────────────────────
	# Real video uploads never touch Caddy — the browser PUTs them straight
	# to S3/R2 with presigned URLs. Everything proxied here is JSON/forms,
	# so a modest cap blunts body-based DoS without hurting the product.
	# Update uploads (S3 binary stream) ride through /api/v1/update/upload —
	# they get a separate, larger cap (see below).
	request_body {
		max_size 25MB
	}

	# ─────────────────────────── rate limiting ────────────────────────────
	# Caddy's built-in `request_body` rate-limiter. Per-IP leaky-bucket,
	# generous enough for the app's polling cadence, tight enough to blunt
	# brute-force / scrape traffic before it hits FastAPI.
	#
	# Two policies:
	#   * Global: 200 req / 10s per IP — anything more is clearly abusive.
	#   * Update upload: 1 upload per IP per 5 min — admins only anyway,
	#     and the binary is huge; never let a loop hammer S3.
	rate_limit {
		# Sub-domain key so all ClipZard paths share the same bucket per IP
		# (a malicious client can't dodge the limit by hitting /api vs /).
		zone clipzard_zone {
			key    {remote_host}
			events 200
			window 10s
		}
	}
	@updateUpload path /api/v1/update/upload /api/v1/update/*
	rate_limit @updateUpload {
		zone clipzard_upload {
			key    {remote_host}
			events 1
			window 5m
		}
	}
	@checkFeed path /api/v1/update-feed/* /api/v1/update/check*
	# Generous: Electron checks every 6h; harmless bots can poll freely.
	rate_limit @checkFeed {
		zone clipzard_check {
			key    {remote_host}
			events 60
			window 1m
		}
	}

	# ─────────────────────── update upload body cap ────────────────────────
	# The Electron installer is ~900MB; raise the per-request cap on the
	# admin upload endpoint. Streaming-hash verification happens server-side.
	@updateUploadBody path /api/v1/update/upload
	request_body @updateUploadBody {
		max_size 2GB
	}

	# ─────────────────────────────── routing ────────────────────────────────
	# License proxy (web) must be reached via /api/license/verify, not backend.
	# Keep this more-specific handle BEFORE the generic /api/* -> backend.
	handle /api/license/verify* {
		reverse_proxy 127.0.0.1:3005 {
			health_uri /
			health_interval 15s
			health_timeout 5s
			header_up X-Real-IP {remote_host}
		}
	}

	# The browser calls the FastAPI backend for auth/CRUD/webhooks (same-site
	# so the httpOnly session cookie works across both origins).
	# Forwarded headers so the backend can log the real client IP and
	# respect the original https scheme.
	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			# Active health check: stop routing to a wedged backend.
			health_uri /health
			health_interval 15s
			health_timeout 5s
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Everything else (SSR marketing site + /app/* client app) goes to Next.js.
	handle {
		reverse_proxy 127.0.0.1:3005 {
			health_uri /
			health_interval 15s
			health_timeout 5s
			header_up X-Real-IP {remote_host}
		}
	}
}

# Catch-all: requests whose Host doesn't match the real domain (scanners,
# DNS rebinding, direct-IP probing) get an explicit rejection instead of
# silently hitting the app.
http://:80, https://:443 {
	respond 421
}
