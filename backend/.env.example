# Shared Postgres (Neon)
DATABASE_URL="postgresql://user:password@host:5432/clipforge"

# Job concurrency. Keep at 1 whenever TRANSCRIPTION_PROVIDER or
# LLM_PROVIDER below point at a local model sharing this machine's
# GPU/CPU/RAM (whisper.cpp, Ollama) — running two jobs at once will
# thrash memory and slow both down. Cloud-only deployments (AssemblyAI +
# hosted LLM) can raise this safely.
WORKERS="1"

# --- Secrets ---------------------------------------------------------------
# Fernet key derivation seed used to encrypt user BYOK API keys at rest.
# Any sufficiently long random string (32+ chars). MUST be stable across
# restarts or stored keys become undecryptable.
APP_SECRET_KEY="replace-with-a-long-random-string"

# --- Transcription ---------------------------------------------------
# "assemblyai" (cloud, default) or "local" (whisper.cpp, fully offline).
TRANSCRIPTION_PROVIDER="assemblyai"

# AssemblyAI (used when TRANSCRIPTION_PROVIDER=assemblyai)
ASSEMBLYAI_KEY=""

# whisper.cpp (used when TRANSCRIPTION_PROVIDER=local). Requires the
# 'pywhispercpp' package — see backend/README.md. WHISPER_MODEL accepts
# any size whisper.cpp recognizes ("base", "small", "medium", "large-v3").
# "base" fits comfortably on a 16GB-RAM machine with no GPU; go bigger only
# if you have RAM/VRAM to spare.
WHISPER_MODEL="base"
WHISPER_THREADS="4"

# --- LLM analysis (OpenAI-compatible) ---------------------------------
# Cloud default:
LLM_API_KEY=""
LLM_BASE_URL="https://ai.sumopod.com/v1"
LLM_MODEL="deepseek-v4-flash"
#
# Local (Ollama) alternative — point these at a local server instead:
#   LLM_API_KEY="ollama"                          # dummy, Ollama ignores it
#   LLM_BASE_URL="http://localhost:11434/v1"      # or http://ollama:11434/v1 in Docker
#   LLM_MODEL="qwen2.5:7b-instruct-q4_K_M"

# S3 / Cloudflare R2
S3_BUCKET="your-bucket"
S3_ENDPOINT_URL="https://<account-id>.r2.cloudflarestorage.com"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="auto"

# CORS allow-list for the browser app (comma-separated). Required for the
# session cookie to work cross-origin in dev (web on :3000, backend on
# :8000). In production, if Caddy proxies both under one domain, this can
# be the same domain (still required — the browser still sends an Origin
# header for fetch requests).
FRONTEND_URLS="http://localhost:3000"

# Set to 1 in production so the httpOnly session cookie carries the `Secure`
# flag (HTTPS-only). Leave off for local http dev.
# COOKIE_SECURE="1"

# --- Captions -------------------------------------------------------------
# Directory the backend mounts caption fonts into (bundled Anton + Space
# Grotesk). libass resolves preset font names against this + fontconfig.
# Defaults to /app/fonts (set in the Docker image); override for local runs.
CAPTION_FONTS_DIR="/app/fonts"

PADDLE_API_KEY=""                  # Developer Tools > Authentication
PADDLE_WEBHOOK_SECRET=""           # Notifications destination secret (pdl_ntfset_…)
PADDLE_ENV="sandbox"               # sandbox | production

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION="0"        # 1 = production, unset/0 = sandbox
MIDTRANS_NOTIFICATION_URL=""

# Pack prices in whole rupiah + USD pack allowances (credit counts):
STARTER_PRICE_IDR="29000"
CREATOR_PRICE_IDR="129000"
STUDIO_PRICE_IDR="399000"

# --- Minute top-ups (credits only, no tier change) ---------------------------
TOPUP_10_CREDITS="10"
TOPUP_10_PRICE_USD="99"
TOPUP_10_PRICE_IDR="16000"
TOPUP_30_CREDITS="30"
TOPUP_30_PRICE_USD="199"
TOPUP_30_PRICE_IDR="32000"
TOPUP_60_CREDITS="60"
TOPUP_60_PRICE_USD="349"
TOPUP_60_PRICE_IDR="55000"
TOPUP_120_CREDITS="120"
TOPUP_120_PRICE_USD="599"
TOPUP_120_PRICE_IDR="95000"

# --- Free tier --------------------------------------------------------------
# A one-time credit grant at signup (no expiry), plus the permanent base
# entitlement limits until the first pack purchase.
FREE_CREDITS="100"
BASE_STORAGE_MB="500"
BASE_MAX_PROJECTS="3"
BASE_MAX_RESOLUTION="720"
BASE_WATERMARK="true"

# --- Packs (USD prices in whole cents; entitlements) -------------------------
STARTER_CREDITS="60"
STARTER_PRICE_USD="290"
STARTER_STORAGE_MB="1024"
STARTER_MAX_PROJECTS="10"
STARTER_MAX_RESOLUTION="1080"
STARTER_WATERMARK="false"

CREATOR_CREDITS="300"
CREATOR_PRICE_USD="1290"
CREATOR_STORAGE_MB="5120"
CREATOR_MAX_PROJECTS="0"        # 0 = unlimited
CREATOR_MAX_RESOLUTION="1080"
CREATOR_WATERMARK="false"

STUDIO_CREDITS="1200"
STUDIO_PRICE_USD="3900"
STUDIO_STORAGE_MB="20480"
STUDIO_MAX_PROJECTS="0"         # 0 = unlimited
STUDIO_MAX_RESOLUTION="2160"
STUDIO_WATERMARK="false"

# --- Bring-your-own-key (BYOK) -----------------------------------------------
# BYOK is hidden/disabled by default (managed operator keys pay credits for
# everyone). Set ENABLE_BYOK=1 to surface per-user LLM/AssemblyAI keys; those
# users then run on their own credits and are unmetered.
# ENABLE_BYOK="0"

# --- Worker queue ---
# WORKERS=1            # concurrent jobs (RAM scales with this)
# MAX_QUEUE_DEPTH=100  # pending-job budget; beyond it new jobs get a 429


