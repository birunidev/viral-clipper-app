# Copy to .env and fill in your values.

# Base URL the browser app uses to reach the FastAPI backend's /api/v1.
# - Dev (web on :3000, backend on :8000): http://localhost:8000/api/v1
# - Prod (Caddy proxies /api/* to the backend on clipzard.web.id):
#     https://clipzard.web.id/api/v1
NEXT_PUBLIC_API_URL="https://clipzard.web.id/api/v1"

# Public base URL the browser uses for absolute asset / OG links.
# Used by Next.js Metadata for canonical/og:url generation.
NEXT_PUBLIC_SITE_URL="https://clipzard.web.id"

# --- Google Analytics (web) ---
# GA4 measurement id; leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_ID="G-LM9G1Z0J4W"
