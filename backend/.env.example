# Shared Postgres (Neon)
DATABASE_URL="postgresql://user:password@host:5432/clipforge"

# Job concurrency. Keep at 1 whenever TRANSCRIPTION_PROVIDER or
# LLM_PROVIDER below point at a local model sharing this machine's
# GPU/CPU/RAM (whisper.cpp, Ollama) — running two jobs at once will
# thrash memory and slow both down. Cloud-only deployments (AssemblyAI +
# hosted LLM) can raise this safely.
WORKERS="1"

# --- Secrets ---------------------------------------------------------------
# Fernet key derivation seed used to encrypt user BYOK API keys at rest.
# Any sufficiently long random string (32+ chars). MUST be stable across
# restarts or stored keys become undecryptable.
APP_SECRET_KEY="replace-with-a-long-random-string"

# --- Transcription ---------------------------------------------------
# "assemblyai" (cloud, default) or "local" (whisper.cpp, fully offline).
TRANSCRIPTION_PROVIDER="assemblyai"

# AssemblyAI (used when TRANSCRIPTION_PROVIDER=assemblyai)
ASSEMBLYAI_KEY=""

# whisper.cpp (used when TRANSCRIPTION_PROVIDER=local). Requires the
# 'pywhispercpp' package — see backend/README.md. WHISPER_MODEL accepts
# any size whisper.cpp recognizes ("base", "small", "medium", "large-v3").
# "base" fits comfortably on a 16GB-RAM machine with no GPU; go bigger only
# if you have RAM/VRAM to spare.
WHISPER_MODEL="base"
WHISPER_THREADS="4"

# --- LLM analysis (OpenAI-compatible) ---------------------------------
# Cloud default:
LLM_API_KEY=""
LLM_BASE_URL="https://ai.sumopod.com/v1"
LLM_MODEL="deepseek-v4-flash"
#
# Local (Ollama) alternative — point these at a local server instead:
#   LLM_API_KEY="ollama"                          # dummy, Ollama ignores it
#   LLM_BASE_URL="http://localhost:11434/v1"      # or http://ollama:11434/v1 in Docker
#   LLM_MODEL="qwen2.5:7b-instruct-q4_K_M"

# S3 / Cloudflare R2
S3_BUCKET="your-bucket"
S3_ENDPOINT_URL="https://<account-id>.r2.cloudflarestorage.com"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="auto"

# CORS allow-list for the browser app (comma-separated). Required for the
# session cookie to work cross-origin in dev (web on :3000, backend on
# :8000). In production, if Caddy proxies both under one domain, this can
# be the same domain (still required — the browser still sends an Origin
# header for fetch requests).
FRONTEND_URLS="http://localhost:3000"

# --- Captions -------------------------------------------------------------
# Directory the backend mounts caption fonts into (bundled Anton + Space
# Grotesk). libass resolves preset font names against this + fontconfig.
# Defaults to /app/fonts (set in the Docker image); override for local runs.
CAPTION_FONTS_DIR="/app/fonts"
