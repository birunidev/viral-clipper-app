# Copy to .env and fill in your values.

# S3 upload for AssemblyAI audio (optional; falls back to AssemblyAI upload if unset)
S3_BUCKET=your-bucket-name
# Custom S3-compatible endpoint. For Cloudflare R2:
# https://<account-id>.r2.cloudflarestorage.com
# S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=auto

# --- Production (docker-compose.yml) ---
# Strong password for the internal Postgres; compose refuses to start without it.
POSTGRES_PASSWORD="change-me-to-a-long-random-string"
# POSTGRES_USER="clipforge"
# POSTGRES_DB="clipforge"
