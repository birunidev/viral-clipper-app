FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg fontconfig fonts-dejavu-core gcc g++ cmake \
    && rm -rf /var/lib/apt/lists/*

ENV POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_CACHE_DIR=/tmp/poetry_cache

RUN pip install --no-cache-dir poetry==2.4.1

WORKDIR /app

COPY pyproject.toml poetry.lock ./

RUN poetry install --only main --extras local --no-root && rm -rf $POETRY_CACHE_DIR

COPY core ./core
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini ./

# Caption preset fonts (Anton, Space Grotesk — SIL OFL).
COPY assets/fonts /app/fonts
RUN fc-cache -f /app/fonts

EXPOSE 8000
CMD ["sh", "-c", "poetry run alembic upgrade head && poetry run uvicorn app.main:app --host 0.0.0.0 --port 8000"]
