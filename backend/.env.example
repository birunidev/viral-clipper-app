# Shared Postgres (Neon)
DATABASE_URL="postgresql://user:password@host:5432/clipforge"

# AssemblyAI
ASSEMBLYAI_KEY=""

# LLM (OpenAI-compatible)
LLM_API_KEY=""
LLM_BASE_URL="https://ai.sumopod.com/v1"
LLM_MODEL="deepseek-v4-flash"

# S3 / Cloudflare R2
S3_BUCKET="your-bucket"
S3_ENDPOINT_URL="https://<account-id>.r2.cloudflarestorage.com"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="auto"

# Shared secret with the Next.js frontend (must match web/.env)
INTERNAL_API_KEY="change-me"

# Optional: lock CORS to your frontend origin
FRONTEND_URL="https://example.com"
