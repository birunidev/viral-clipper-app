{
  "name": "clipzard-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ClipZard Desktop - fully local viral clip engine",
  "author": "ClipZard <hello@clipzard.web.id>",
  "homepage": "https://clipzard.web.id",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20.18.0 <24"
  },
  "engineStrict": false,
  "scripts": {
    "dev": "concurrently -k -n tsc,preload,renderer,electron -c blue,cyan,green,magenta \"tsc --watch\" \"esbuild src/preload.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron --watch\" \"npm --prefix renderer run dev\" \"wait-on http://localhost:5173 && ELECTRON_DEV_URL=http://localhost:5173 electron .\"",
    "dev:electron": "tsc && esbuild src/preload.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron && electron .",
    "dev:renderer": "npm --prefix renderer run dev",
    "build": "tsc && esbuild src/preload.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron && electron-builder",
    "build:win": "tsc && esbuild src/preload.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron && electron-builder --win",
    "build:mac": "tsc && esbuild src/preload.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron && electron-builder --mac",
    "build:linux": "tsc && esbuild src/preload.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron && electron-builder --linux",
    "typecheck": "tsc --noEmit",
    "typecheck:renderer": "tsc --noEmit --project renderer/tsconfig.json",
    "models:download": "node scripts/download-models.mjs",
    "models:download:all": "node scripts/download-models.mjs --all",
    "setup:local-ai": "node scripts/setup-local-ai.mjs",
    "setup:whisper": "node scripts/setup-local-ai.mjs --build-whisper-only",
    "setup:models": "node scripts/setup-local-ai.mjs --models-only",
    "test:e2e:headless": "xvfb-run -a npx playwright test --config=playwright.config.headless.ts",
    "test:e2e:headed": "npx playwright test --config=playwright.config.headless.ts --headed",
    "test:e2e:debug": "npx playwright test --config=playwright.config.headless.ts --headed --debug",
    "rebuild": "electron-rebuild",
    "postinstall": "node -e \"try{require('fs').writeFileSync('node_modules/electron/path.txt','electron')}catch{};try{require('fs').chmodSync('node_modules/electron/dist/chrome-sandbox',0o4755)}catch{}\""
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.0.0",
    "sqlite-electron": "^3.9.12",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.0.0",
    "concurrently": "^10.0.5",
    "electron": "^32.3.3",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0",
    "wait-on": "^9.1.0"
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.6.0"
  }
}
