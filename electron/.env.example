# ClipZard Desktop — Electron env
# Copy to .env and adjust. Dev now hits PROD license by default (no bypass).

# --- License (prod by default) ---
# Dev hits prod directly. Unset LICENSE_ENFORCE to bypass in offline dev, or override URL for local:
LICENSE_VERIFY_URL=https://clipzard.web.id/api/license/verify
# LICENSE_VERIFY_URL=http://localhost:3005/api/license/verify  # local dev server
# LICENSE_ENFORCE=1  # force verification even when unpacked (npm run dev)
# LICENSE_VERIFY_URL=https://clipzard.web.id/api/license/verify  # explicit prod (default)

# --- Pure Node pipeline (default, no backend) ---
# No DATABASE_URL needed — uses SQLite at app.getPath(userData)/clipzard.db
# Optional: force a different data dir
# USER_DATA_PATH=/tmp/clipzard-data

# --- Transcription ---
# whisper.cpp model auto-selected by RAM tier (system.ts):
#   low (<12GB) -> base, mid (12-20GB) -> small, high (>=20GB) -> medium
# Override if you want to pin:
# WHISPER_MODEL=base
# WHISPER_THREADS=4

# --- LLM analysis ---
# Option A: cloud OpenAI-compatible (fast, high quality)
# LLM_BASE_URL=https://ai.sumopod.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-v4-flash

# Option B: local GGUF via node-llama-cpp (offline, default if above is empty)
# Models are resolved by tier (system.ts:18):
#   low  -> qwen2.5-1.5b-q4_k_m.gguf  (~950 MB)  balanced
#   tiny -> qwen2.5-0.5b-q4_k_m.gguf  (~380 MB)  via LLM_TIER=tiny
#   mid  -> qwen2.5-7b-q4_k_m.gguf  (~4.7 GB)
#   high -> qwen2.5-14b-q4_k_m.gguf (~8.5 GB)
# Override URL/file if you self-host:
# LLM_MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-7B-Instruct-GGUF/resolve/main/qwen2.5-7b-instruct-q4_k_m.gguf
# LLM_MODEL_FILE=qwen2.5-7b-q4_k_m.gguf
# LLM_CHUNK_CHARS=9000

# --- Embedded FastAPI (OPTIONAL, off by default) ---
# Pure Node pipeline is recommended. Enable only if you want Python backend inside Electron:
# USE_FASTAPI_LOCAL=1
# ELECTRON_USE_FASTAPI=1
# PYTHON_BIN=/usr/bin/python3
# DATABASE_URL=sqlite:////path/to/db  # auto-generated at userData if empty

# --- Build flags (installer size) ---
# By default the desktop build pre-downloads whisper+LLM to userData and verifies deps.
# For a lean installer (~150MB) skip the multi-GB LLM — it will be fetched on-demand
# in the installed app (analyzer.ts ensureLlmModel, Settings → Download).
#   SKIP_LLM=1 npm run build            # skip LLM only (keep whisper) ← lean default in build-all.sh
#   SKIP_MODELS=1 npm run build         # skip all models (whisper+LLM)
#   WITH_MODELS=1 npm run build         # bundle models into resources/models for offline installer
#   npm run build:skip-llm              # shorthand for SKIP_LLM=1
# In download-models directly:
#   SKIP_LLM=1 node scripts/download-models.mjs
#   node scripts/download-models.mjs --skip-llm --out=resources/models

# --- Binaries (optional overrides) ---
# Binaries are auto-resolved from:
#   1) resources/bin/<platform>-<arch>/  (bundled)
#   2) ffmpeg-static / yt-dlp-exec npm packages
#   3) system PATH
# Override search root:
# RESOURCES_PATH=/path/to/resources
