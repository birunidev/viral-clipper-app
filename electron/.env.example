# ClipForge Desktop — Electron env
# Copy to .env and adjust. All vars are OPTIONAL for dev (mocks + bypass).
# For production installer, set real values at build time.

# --- Dev bypass (default: licensed=true when unpacked) ---
# LICENSE_VERIFY_URL=https://clipforge.com/api/license/verify
# For local license server dev (optional):
# LICENSE_VERIFY_URL=http://localhost:3005/api/license/verify

# --- Pure Node pipeline (default, no backend) ---
# No DATABASE_URL needed — uses SQLite at app.getPath(userData)/clipforge.db
# Optional: force a different data dir
# USER_DATA_PATH=/tmp/clipforge-data

# --- Transcription ---
# whisper.cpp model auto-selected by RAM tier (system.ts):
#   low (<12GB) -> base, mid (12-20GB) -> small, high (>=20GB) -> medium
# Override if you want to pin:
# WHISPER_MODEL=base
# WHISPER_THREADS=4

# --- LLM analysis ---
# Option A: cloud OpenAI-compatible (fast, high quality)
# LLM_BASE_URL=https://ai.sumopod.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-v4-flash

# Option B: local GGUF via node-llama-cpp (offline, default if above is empty)
# Models are resolved by tier (system.ts:18):
#   low  -> qwen2.5-3b-q4_k_m.gguf  (~2GB)
#   mid  -> qwen2.5-7b-q4_k_m.gguf  (~4.5GB)
#   high -> qwen2.5-14b-q4_k_m.gguf (~8GB)
# Override URL/file if you self-host:
# LLM_MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-7B-Instruct-GGUF/resolve/main/qwen2.5-7b-instruct-q4_k_m.gguf
# LLM_MODEL_FILE=qwen2.5-7b-q4_k_m.gguf
# LLM_CHUNK_CHARS=9000

# --- Embedded FastAPI (OPTIONAL, off by default) ---
# Pure Node pipeline is recommended. Enable only if you want Python backend inside Electron:
# USE_FASTAPI_LOCAL=1
# ELECTRON_USE_FASTAPI=1
# PYTHON_BIN=/usr/bin/python3
# DATABASE_URL=sqlite:////path/to/db  # auto-generated at userData if empty

# --- Binaries (optional overrides) ---
# Binaries are auto-resolved from:
#   1) resources/bin/<platform>-<arch>/  (bundled)
#   2) ffmpeg-static / yt-dlp-exec npm packages
#   3) system PATH
# Override search root:
# RESOURCES_PATH=/path/to/resources
