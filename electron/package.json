{
  "name": "clipforge-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ClipForge Desktop - fully local viral clip engine",
  "author": "ClipForge <hello@clipforge.com>",
  "homepage": "https://clipforge.com",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "tsc && electron-builder",
    "build:win": "tsc && electron-builder --win",
    "build:linux": "tsc && electron-builder --linux",
    "typecheck": "tsc --noEmit",
    "rebuild": "electron-rebuild"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.0.0",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.5.0"
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.6.0"
  }
}
